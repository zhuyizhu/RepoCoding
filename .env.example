# Copy to .env for local Docker Compose. This file intentionally contains no model secret.
POSTGRES_USER=repocoding
POSTGRES_PASSWORD=repocoding
POSTGRES_DB=repocoding
DATABASE_URL=postgresql+psycopg://repocoding:repocoding@postgres:5432/repocoding
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173
REPOSITORY_ROOT=/workspace/repos
REPOGRAPH_ROOT=/workspace/repographs
CODELENS_HOME=/opt/codelens
EVISTATE_HOME=/opt/evistate
WORKTREE_ROOT=/workspace/worktrees
VECTORSTORE_ROOT=/workspace/vectorstores
SANDBOX_URL=http://java-sandbox:8080

# vLLM OpenAI-compatible endpoint; set the address for your current port forwarding.
LLM_PROVIDER=openai
LLM_MODEL=qwen2.5-coder-7b-instruct
LLM_API_URL=http://REPLACE_WITH_REACHABLE_HOST:8088/v1
LLM_API_KEY=EMPTY

ARTIFACT_ROOT=/workspace/artifacts

# The deployment Compose file enables repair for its CodeLens -> EviState -> Qwen workflow.
# Leave this false for direct local API runs unless the Java runner is ready.
REPAIR_ENABLED=false
REPAIR_MAX_LLM_CALLS=6

HF_HOME=/workspace/model-cache
CODE_EMBEDDING_MODEL=BAAI/bge-m3
